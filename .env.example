VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server/CLI only. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-database-password
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=your-project-ref
# Supabase CLI only: use a personal access token from your account, not the service-role key.
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Configure these as Supabase Edge Function secrets, never in VITE_ variables:
# OPENROUTER_API_KEY=sk-or-v1-...
# APP_URL=https://your-project.supabase.co
# Optional comma-separated overrides; only IDs ending in :free are accepted.
# OPENROUTER_FREE_MODELS=deepseek/deepseek-r1:free,qwen/qwen3.8-27b:free
